; Engine configuration file.
; Edit through Godot when possible.

config_version=5

[application]

config/name="CHARGE! // Four Game Lab"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[input]

move_left={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319), Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0), Object(InputEventJoypadButton,"button_index":13)]
}
move_right={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321), Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0), Object(InputEventJoypadButton,"button_index":14)]
}
jump={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":32), Object(InputEventKey,"physical_keycode":90), Object(InputEventKey,"physical_keycode":4194320), Object(InputEventJoypadButton,"button_index":0), Object(InputEventJoypadButton,"button_index":11)]
}
dash={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":88), Object(InputEventKey,"physical_keycode":4194325), Object(InputEventKey,"physical_keycode":4194322), Object(InputEventJoypadButton,"button_index":2), Object(InputEventJoypadButton,"button_index":12)]
}
attack={
"deadzone": 0.3,
"events": [Object(InputEventKey,"physical_keycode":67), Object(InputEventKey,"physical_keycode":74), Object(InputEventJoypadButton,"button_index":3)]
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.015, 0.022, 0.043, 1)

[audio]

driver/enable_input=false
